{
  "name": "cairn",
  "productName": "Cairn",
  "version": "0.1.0",
  "description": "Cairn: projects, tasks, a kanban board and completion calendars in one portable data file.",
  "author": "remii.online",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "test": "node scripts/build.mjs test && node --test dist-test/model.test.mjs dist-test/storage.test.mjs",
    "preview": "node scripts/preview.mjs",
    "smoke": "node scripts/build.mjs && electron . --smoke-test",
    "demo": "node scripts/build.mjs && electron . --demo",
    "screenshots": "node scripts/build.mjs && electron . --screenshots ../docs/images",
    "dist:win": "node scripts/build.mjs && electron-builder --win",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux",
    "icon": "electron scripts/make-icon.cjs"
  },
  "build": {
    "appId": "online.remii.cairn",
    "productName": "Cairn",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "remii.online",
      "syncDesktopName": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@types/node": "26.6.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "desktopName": "cairn.desktop",
  "license": "MIT"
}
